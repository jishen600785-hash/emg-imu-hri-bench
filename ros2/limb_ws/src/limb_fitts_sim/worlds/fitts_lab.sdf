<?xml version="1.0"?>
<sdf version="1.9">
  <world name="fitts_world">
    <physics name="fast" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.08 0.10 0.14 1</background>
      <shadows>true</shadows>
      <grid>true</grid>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.4 0.2 -1</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="collision">
          <geometry><box><size>8 8 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8 8 0.1</size></box></geometry>
          <material><ambient>0.16 0.18 0.22 1</ambient><diffuse>0.20 0.23 0.28 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="workbench">
      <static>true</static>
      <pose>0.35 0 0 0 0 0</pose>
      <link name="bench_link">
        <collision name="top_collision">
          <pose>0 0 0.66 0 0 0</pose>
          <geometry><box><size>1.6 1.4 0.08</size></box></geometry>
        </collision>
        <visual name="top_visual">
          <pose>0 0 0.66 0 0 0</pose>
          <geometry><box><size>1.6 1.4 0.08</size></box></geometry>
          <material><ambient>0.32 0.16 0.06 1</ambient><diffuse>0.62 0.32 0.10 1</diffuse></material>
        </visual>
        <visual name="leg1"><pose>0.67 0.52 0.31 0 0 0</pose><geometry><box><size>0.08 0.08 0.62</size></box></geometry></visual>
        <visual name="leg2"><pose>0.67 -0.52 0.31 0 0 0</pose><geometry><box><size>0.08 0.08 0.62</size></box></geometry></visual>
        <visual name="leg3"><pose>-0.67 0.52 0.31 0 0 0</pose><geometry><box><size>0.08 0.08 0.62</size></box></geometry></visual>
        <visual name="leg4"><pose>-0.67 -0.52 0.31 0 0 0</pose><geometry><box><size>0.08 0.08 0.62</size></box></geometry></visual>
      </link>
    </model>

    <model name="fitts_plane">
      <static>true</static>
      <pose>-0.12 0.45 1.279 0 0 0</pose>
      <link name="plane_link">
        <visual name="plane_visual">
          <geometry><box><size>0.72 0.72 0.004</size></box></geometry>
          <material><ambient>0.08 0.28 0.55 0.22</ambient><diffuse>0.08 0.28 0.55 0.22</diffuse></material>
          <transparency>0.72</transparency>
        </visual>
      </link>
    </model>

    <!-- Fixed experiment camera. Its optical axis points toward the robot and
         task plane, so recording also works when Gazebo runs headlessly. -->
    <model name="fitts_recording_camera">
      <static>true</static>
      <pose>-2.20 -2.20 2.20 0 0.34 0.7854</pose>
      <link name="camera_link">
        <visual name="camera_body">
          <pose>-0.08 0 0 0 0 0</pose>
          <geometry><box><size>0.16 0.10 0.10</size></box></geometry>
          <material><ambient>0.04 0.04 0.05 1</ambient><diffuse>0.08 0.08 0.10 1</diffuse></material>
        </visual>
        <sensor name="task_camera" type="camera">
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <topic>/fitts/camera/image</topic>
          <visualize>false</visualize>
          <camera name="fitts_task_camera">
            <horizontal_fov>1.0472</horizontal_fov>
            <image>
              <width>960</width>
              <height>540</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.10</near>
              <far>20.0</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

    <model name="fitts_target_w025">
      <static>true</static><pose>0 0 -1 0 0 0</pose>
      <link name="target"><visual name="visual"><geometry><sphere><radius>0.0125</radius></sphere></geometry><material><ambient>1 0.01 0.01 1</ambient><diffuse>1 0.02 0.01 1</diffuse><emissive>0.55 0 0 1</emissive></material></visual></link>
    </model>
    <model name="fitts_target_w040">
      <static>true</static><pose>0 0 -1 0 0 0</pose>
      <link name="target"><visual name="visual"><geometry><sphere><radius>0.020</radius></sphere></geometry><material><ambient>1 0.01 0.01 1</ambient><diffuse>1 0.02 0.01 1</diffuse><emissive>0.55 0 0 1</emissive></material></visual></link>
    </model>
    <model name="fitts_target_w060">
      <static>true</static><pose>0 0 -1 0 0 0</pose>
      <link name="target"><visual name="visual"><geometry><sphere><radius>0.030</radius></sphere></geometry><material><ambient>1 0.01 0.01 1</ambient><diffuse>1 0.02 0.01 1</diffuse><emissive>0.55 0 0 1</emissive></material></visual></link>
    </model>

    <model name="fitts_previous_w025">
      <static>true</static><pose>0 0 -1 0 0 0</pose>
      <link name="target"><visual name="visual"><geometry><sphere><radius>0.0125</radius></sphere></geometry><material><ambient>0.02 0.8 0.12 1</ambient><diffuse>0.03 0.95 0.18 1</diffuse><emissive>0 0.35 0.04 1</emissive></material></visual></link>
    </model>
    <model name="fitts_previous_w040">
      <static>true</static><pose>0 0 -1 0 0 0</pose>
      <link name="target"><visual name="visual"><geometry><sphere><radius>0.020</radius></sphere></geometry><material><ambient>0.02 0.8 0.12 1</ambient><diffuse>0.03 0.95 0.18 1</diffuse><emissive>0 0.35 0.04 1</emissive></material></visual></link>
    </model>
    <model name="fitts_previous_w060">
      <static>true</static><pose>0 0 -1 0 0 0</pose>
      <link name="target"><visual name="visual"><geometry><sphere><radius>0.030</radius></sphere></geometry><material><ambient>0.02 0.8 0.12 1</ambient><diffuse>0.03 0.95 0.18 1</diffuse><emissive>0 0.35 0.04 1</emissive></material></visual></link>
    </model>
  </world>
</sdf>
